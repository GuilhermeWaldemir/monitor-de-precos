# Copie este arquivo para ".env" e preencha. O .env fica FORA do Git (.gitignore).
# O site lê essas variáveis ao iniciar (monitor/config.py).

# --- Envio de e-mail dos alertas de preço ---
# Com Gmail, use uma SENHA DE APP (Conta Google > Segurança > Senhas de app),
# nunca a senha normal da conta.
# TROQUE pelo seu e-mail de verdade (o do exemplo abaixo nao funciona).
MONITOR_SMTP_USER=seu-email@gmail.com
# Pode colar com ou sem espacos: "abcd efgh ijkl mnop" funciona igual.
MONITOR_SMTP_PASSWORD=senha-de-app-de-16-letras

# Opcionais (estes são os padrões):
# MONITOR_SMTP_HOST=smtp.gmail.com
# MONITOR_SMTP_PORT=587
# MONITOR_EMAIL_FROM=seu-email@gmail.com

# --- API oficial do Mercado Livre ---
# Crie a aplicação em developers.mercadolivre.com.br (Minhas aplicações > Criar aplicação).
# MONITOR_ML_CLIENT_ID=seu-app-id
# MONITOR_ML_CLIENT_SECRET=sua-secret-key
# MONITOR_ML_REDIRECT_URI=http://127.0.0.1:5000/mercadolivre/callback

# --- Segurança da sessão ---
# Em produção, use um valor secreto e aleatório:
# SECRET_KEY=troque-por-um-valor-aleatorio-longo
